              "content": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>relaudit · 审计报告面板（离线自包含版）</title>\n  <!-- 离线自包含交付：全部 CSS 与 JS 已内联，报告数据已嵌入；无 CDN、无外链、无联网请求。\n       在线版由 public/app.js 提供（通过 /api/audit 拉取实时报告）。 -->\n  <style>\n    body { font-family: system-ui, sans-serif; margin: 24px; color: #1c2733; }\n    h1 { font-size: 20px; }\n    #summary-cards { display: flex; gap: 12px; margin: 12px 0; }\n    .card { border: 1px solid #ccc; border-radius: 8px; padding: 8px 16px; min-width: 80px; }\n    .card .count { font-size: 22px; font-weight: 700; }\n    .card-error { border-color: #d33; } .card-error .count { color: #d33; }\n    .card-warn { border-color: #e9a; } .card-warn .count { color: #b60; }\n    .card-info { border-color: #88c; } .card-info .count { color: #48c; }\n    table { border-collapse: collapse; width: 100%; margin-top: 12px; }\n    th, td { border: 1px solid #dde; padding: 6px 10px; text-align: left; font-size: 13px; }\n    .row-error td { background: #fdf2f2; }\n    .row-warn td { background: #fff8ee; }\n    .row-info td { background: #f4f7fd; }\n    #summary-text { margin-left: 16px; font-size: 13px; color: #556; }\n    #controls { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; margin: 12px 0; }\n    #controls .ctl { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #334; }\n    #controls select, #controls input {\n      font: inherit; padding: 4px 8px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff;\n    }\n    #controls #rule-prefix { width: 120px; }\n    #group-summary { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 4px; }\n    .group-chip {\n      display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px;\n      border: 1px solid #cbd5e1; background: #f1f5f9; color: #334;\n    }\n    .group-chip.group-error { border-color: #d33; background: #fdf2f2; color: #b22; }\n    .group-chip.group-warn { border-color: #e9a; background: #fff8ee; color: #b60; }\n    .group-chip.group-info { border-color: #88c; background: #f4f7fd; color: #48c; }\n    .copy-btn {\n      font: inherit; font-size: 12px; padding: 3px 10px; cursor: pointer;\n      border: 1px solid #94a3b8; border-radius: 6px; background: #fff; color: #1c2733;\n    }\n    .copy-btn:hover { background: #f1f5f9; }\n    .copy-btn:active { background: #e2e8f0; }\n  </style>\n</head>\n<body>\n  <div id=\"app\"></div>\n  <script>\n  (function () {\n    'use strict';\n\n    // ---- embedded audit report (offline, no API backfill) ----\n    var REPORT = {\n      pkg: 'dsh-sample-plugin',\n      version: '1.3.0',\n      auditedAt: '2025-05-29T12:00:00.000Z',\n      findings: [\n        { rule: 'R1', severity: 'error', message: 'CHANGELOG 头版本 1.2.0 ≠ package.json 版本 1.3.0', file: 'package.json' },\n        { rule: 'R1', severity: 'error', message: 'package.json 版本 1.3.0 未大于最近发布 1.3.0', file: 'package.json' },\n        { rule: 'R2', severity: 'error', message: '产物 tarball 为空或不可解析', file: 'dist/' },\n        { rule: 'R3', severity: 'warn', message: 'main 文件为空: lib/index.js', file: 'lib/index.js' },\n        { rule: 'R4', severity: 'warn', message: 'build.sh:7 调用未许可命令 curl', file: 'scripts/build.sh' },\n        { rule: 'R5', severity: 'warn', message: '依赖 left-pad（link 依赖）未在 node_modules 清单中', file: 'package.json' },\n        { rule: 'R6', severity: 'warn', message: 'CHANGELOG 版本 1.3.0 缺少 Fixed 节', file: 'CHANGELOG.md' },\n        { rule: 'R7', severity: 'warn', message: 'README 当前标注 v1.2.0 ≠ package.json v1.3.0', file: 'README.md' },\n        { rule: 'R8', severity: 'error', message: '产物条目 docs/extra/notes.md 未在 files 字段声明', file: 'dist/relaudit-plugin-1.3.0.tgz' },\n        { rule: 'R9', severity: 'info', message: '建议补充 SECURITY.md 安全说明', file: 'SECURITY.md' }\n      ],\n      summary: { errors: 4, warns: 5, infos: 1, total: 10 }\n    };\n\n    // ---- pure logic (mirrors public/filter.js, public/format.js, src/render-panel.js) ----\n    var SEVERITY_ORDER = { info: 0, warn: 1, error: 2 };\n    var SEVERITY_LABEL = { error: '错误', warn: '警告', info: '提示' };\n\n    function escapeHtml(text) {\n      return String(text)\n        .replace(/&/g, '&amp;')\n        .replace(/</g, '&lt;')\n        .replace(/>/g, '&gt;')\n        .replace(/\"/g, '&quot;');\n    }\n\n    function applyFilter(rows, options) {\n      options = options || {};\n      var min = SEVERITY_ORDER[options.minSeverity || 'info'] || 0;\n      var prefix = options.rulePrefix || '';\n      return rows.filter(function (row) {\n        return (SEVERITY_ORDER[row.severity] || 0) >= min\n          && (prefix === '' || String(row.rule).indexOf(prefix) === 0);\n      });\n    }\n\n    function groupByRule(rows) {\n      var map = {};\n      rows.forEach(function (row) {\n        if (!map[row.rule]) map[row.rule] = { rule: row.rule, count: 0, severity: 'info' };\n        var g = map[row.rule];\n        g.count += 1;\n        if ((SEVERITY_ORDER[row.severity] || 0) > (SEVERITY_ORDER[g.severity] || 0)) g.severity = row.severity;\n      });\n      return Object.keys(map).map(function (k) { return map[k]; }).sort(function (a, b) {\n        var d = (SEVERITY_ORDER[b.severity] || 0) - (SEVERITY_ORDER[a.severity] || 0);\n        if (d !== 0) return d;\n        return String(a.rule).localeCompare(String(b.rule));\n      });\n    }\n\n    function formatCounts(c) {\n      return '错误 ' + c.errors + ' · 警告 ' + c.warns + ' · 提示 ' + c.infos;\n    }\n\n    function countTotal(c) {\n      return (Number(c.errors) || 0) + (Number(c.warns) || 0) + (Number(c.infos) || 0);\n    }\n\n    function severityLabel(s) { return SEVERITY_LABEL[s] || s; }\n\n    function copyFixSnippet(f) {\n      return 'relaudit fix --rule=' + (f.rule || '') + ' --file=' + (f.file || '');\n    }\n\n    function renderSummaryText(summary) {\n      return '错误 ' + summary.errors + ' · 警告 ' + summary.warns + ' · 提示 ' + summary.infos + ' · 共 ' + summary.total + ' 条';\n    }\n\n    function renderRows(findings) {\n      return (findings || []).map(function (f) {\n        return '<tr class=\"row-' + f.severity + '\" data-rule=\"' + escapeHtml(f.rule) + '\" data-severity=\"' + f.severity + '\">'\n          + '<td>' + escapeHtml(f.rule) + '</td>'\n          + '<td>' + escapeHtml(f.severity) + '</td>'\n          + '<td class=\"msg\">' + escapeHtml(f.message) + '</td>'\n          + '<td class=\"file\">' + escapeHtml(f.file || '') + '</td>'\n          + '<td class=\"act\"><button type=\"button\" class=\"copy-btn\" data-rule=\"' + escapeHtml(f.rule) + '\" data-file=\"' + escapeHtml(f.file || '') + '\">复制修复片段</button></td>'\n          + '</tr>';\n      }).join('\\n');\n    }\n\n    function renderGroupSummary(findings) {\n      var groups = groupByRule(findings || []);\n      if (groups.length === 0) return '';\n      return groups.map(function (g) {\n        return '<span class=\"group-chip group-' + g.severity + '\" data-rule=\"' + escapeHtml(g.rule) + '\">'\n          + escapeHtml(g.rule) + '(' + g.count + ')</span>';\n      }).join('\\n');\n    }\n\n    function renderPanelHtml(report) {\n      var summary = report.summary || { errors: 0, warns: 0, infos: 0, total: 0 };\n      var findings = report.findings || [];\n      var cards = ['error', 'warn', 'info'].map(function (sev) {\n        return '<div class=\"card card-' + sev + '\">'\n          + '<span class=\"count\" data-sev=\"' + sev + '\">' + (summary[sev + 's'] || 0) + '</span>'\n          + '<span class=\"label\">' + (SEVERITY_LABEL[sev] || sev) + '</span></div>';\n      }).join('\\n');\n      return '<h1>审计报告：' + escapeHtml(report.pkg || '') + ' v' + escapeHtml(report.version || '') + '</h1>'\n        + '<div id=\"summary-cards\">' + cards + '</div>'\n        + '<div id=\"controls\">'\n        + '<label class=\"ctl\">级别<select id=\"min-severity\">'\n        + '<option value=\"info\">全部</option><option value=\"warn\">警告及以上</option><option value=\"error\">仅错误</option>'\n        + '</select></label>'\n        + '<label class=\"ctl\">规则前缀<input id=\"rule-prefix\" type=\"text\" placeholder=\"如 R1\" autocomplete=\"off\" /></label>'\n        + '<div id=\"summary-text\">' + renderSummaryText(summary) + '</div>'\n        + '</div>'\n        + '<div id=\"group-summary\">' + renderGroupSummary(findings) + '</div>'\n        + '<table id=\"findings\"><thead><tr><th>规则</th><th>级别</th><th>说明</th><th>文件</th><th>操作</th></tr></thead>'\n        + '<tbody id=\"rows\">' + renderRows(findings) + '</tbody></table>';\n    }\n\n    // ---- clipboard (with execCommand fallback for non-secure/file:// contexts) ----\n    function fallbackCopy(text) {\n      var ta = document.createElement('textarea');\n      ta.value = text;\n      ta.style.position = 'fixed';\n      ta.style.top = '-1000px';\n      ta.style.opacity = '0';\n      document.body.appendChild(ta);\n      ta.select();\n      try { document.execCommand('copy'); } catch (e) { /* ignore */ }\n      document.body.removeChild(ta);\n    }\n    function copyText(text) {\n      if (navigator.clipboard && navigator.clipboard.writeText) {\n        navigator.clipboard.writeText(text).catch(function () { fallbackCopy(text); });\n      } else {\n        fallbackCopy(text);\n      }\n    }\n\n    // ---- boot: synchronous, offline, no fetch / no \"加载中\" ----\n    function wire(root, report) {\n      var minSel = root.querySelector('#min-severity');\n      var prefixInput = root.querySelector('#rule-prefix');\n      var rowsEl = root.querySelector('#rows');\n      var groupEl = root.querySelector('#group-summary');\n      var summaryEl = root.querySelector('#summary-text');\n\n      root.addEventListener('click', function (e) {\n        var t = e.target;\n        var btn = t && t.closest ? t.closest('.copy-btn') : null;\n        if (!btn) return;\n        copyText(copyFixSnippet({ rule: btn.getAttribute('data-rule'), file: btn.getAttribute('data-file') }));\n        var old = btn.textContent;\n        btn.textContent = '已复制';\n        setTimeout(function () { btn.textContent = old; }, 1200);\n      });\n\n      function update() {\n        var filtered = applyFilter(report.findings, {\n          minSeverity: minSel.value,\n          rulePrefix: prefixInput.value.trim(),\n        });\n        rowsEl.innerHTML = renderRows(filtered);\n        groupEl.innerHTML = renderGroupSummary(filtered);\n        var counts = { errors: 0, warns: 0, infos: 0 };\n        filtered.forEach(function (f) {\n          if (f.severity === 'error') counts.errors++;\n          else if (f.severity === 'warn') counts.warns++;\n          else counts.infos++;\n        });\n        counts.total = filtered.length;\n        summaryEl.textContent = renderSummaryText(counts);\n      }\n\n      minSel.addEventListener('change', update);\n      prefixInput.addEventListener('input', update);\n    }\n\n    function boot() {\n      var root = document.getElementById('app');\n      root.innerHTML = renderPanelHtml(REPORT);\n      wire(root, REPORT);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', boot);\n    } else {\n      boot();\n    }\n  })();\n  </script>\n</body>\n</html>"
            }
