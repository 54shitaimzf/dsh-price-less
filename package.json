{
  "name": "@dsh-external/dsh-context-economy",
  "version": "0.0.1",
  "description": "DSH 插件（模板态）：最小 settings 段 + 设置 UI 壳（组件/交互设计保留），主体待重设计（docs/ 为设计单一事实源）",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-settings": ">=0.1.3-alpha.1 <2",
    "@deepseek-ai/dsh-session": ">=0.1.3-alpha.1 <2",
    "@deepseek-ai/dsh-llm": ">=0.1.3-alpha.1 <2",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "react",
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run --pool=threads",
    "assert": "node scripts/assert-structure.mjs",
    "gate": "npm run typecheck && npm run typecheck:client && npm test && npm run assert"
  }
}
