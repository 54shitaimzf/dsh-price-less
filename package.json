{
  "name": "dsh-price-less",
  "version": "0.0.1",
  "description": "DSH 上下文管理插件：任务边界、项目帧、自动判别与上下文优化（开发中，R2 判别域 P8–P14b1 已施工）",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "presets"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-settings": ">=0.1.3-alpha.1 <2 || >=0.1.5-alpha.0 <2",
    "@deepseek-ai/dsh-session": ">=0.1.3-alpha.1 <2 || >=0.1.5-alpha.0 <2",
    "@deepseek-ai/dsh-llm": ">=0.1.3-alpha.1 <2 || >=0.1.5-alpha.0 <2",
    "@deepseek-ai/dsh-skill": ">=0.1.3-alpha.1 <2 || >=0.1.5-alpha.0 <2",
    "schemastery": "^3.18.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.3-alpha.1 <2 || >=0.1.5-alpha.0 <2",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-compaction": ">=0.1.3-alpha.1 <2 || >=0.1.5-alpha.0 <2",
    "@deepseek-ai/dsh-agent": ">=0.1.3-alpha.1 <2 || >=0.1.5-alpha.0 <2",
    "@deepseek-ai/dsh-token-meter": ">=0.1.3-alpha.1 <2 || >=0.1.5-alpha.0 <2",
    "@deepseek-ai/dsh-commands": ">=0.1.3-alpha.1 <2 || >=0.1.5-alpha.0 <2",
    "@deepseek-ai/dsh-tools": ">=0.1.3-alpha.1 <2 || >=0.1.5-alpha.0 <2",
    "@deepseek-ai/dsh-fs": ">=0.1.3-alpha.1 <2 || >=0.1.5-alpha.0 <2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.3-alpha.1 <2 || >=0.1.5-alpha.0 <2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "react",
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run --pool=threads",
    "assert": "node scripts/assert-structure.mjs",
    "gate": "npm run typecheck && npm run typecheck:client && npm test && npm run assert",
    "smoke:lib": "node scripts/smoke-lib.mjs"
  }
}
