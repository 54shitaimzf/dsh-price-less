{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "tests/ce-logger.spec.ts",
    "tests/llm-purpose.spec.ts",
    "tests/llm-stream-robustness.spec.ts",
    "tests/tools.spec.ts",
    "tests/storage.spec.ts",
    "tests/skills.spec.ts",
    "tests/history.spec.ts",
    "tests/units.spec.ts",
    "tests/prefix.spec.ts",
    "tests/prefix-wiring.spec.ts",
    "tests/dossier.spec.ts"
  ]
}
